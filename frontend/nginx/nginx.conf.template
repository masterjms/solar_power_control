# 관리 화면 nginx 설정 (컨테이너 iotlight-web, 포트 80).
# 공식 nginx 이미지 entrypoint 가 envsubst 로 /etc/nginx/conf.d/default.conf 를 만든다.
# 치환할 변수가 없으므로 $uri 등 nginx 변수는 그대로 남는다 (NGINX_ENVSUBST_FILTER 참고).
#
# 보호: 전 경로 HTTP Basic auth. /api 에 아직 로그인이 없어서(docs/05) 로그인 기능이
# 붙을 때까지의 임시 장치다. 계정은 .env 의 ADMIN_USER / ADMIN_PASSWORD 로 기동 시 생성.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;
    gzip_min_length 1024;

    auth_basic "iotlight";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # 브로커 인증 엔드포인트 — 프록시하지 않지만 명시적으로 막아 둔다.
    location /internal/ {
        return 404;
    }

    # 백엔드 (컨테이너 네트워크 안 서비스명). 경로 그대로 전달.
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite 산출물은 파일명에 해시가 붙는다 — 길게 캐시
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA: 없는 경로는 index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
