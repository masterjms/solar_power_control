   {"key": "stop_ofst", "label": "종료 Offset", "unit": "분", "scale": 1, "min": -60, "max": 60, "default": 0, "widget": "spin", "help": "일출 기준 소등 시각을 당기거나(-) 늦춘다(+)"},
