 "rules": [
  {"id": "batt12_order", "text": "cut12 < rtn12", "why": "어기면 단말이 Flash 저장 때 두 값을 기본값(12.75 / 13.15V)으로 조용히 바꾼다"},
  {"id": "batt24_order", "text": "cut24 < rtn24", "why": "어기면 단말이 Flash 저장 때 두 값을 기본값(25.50 / 26.30V)으로 조용히 바꾼다"},
  {"id": "stage_order", "text": "1→2→3→4단계 시각이 저녁부터 밤 순서로 이어지고(자정 넘김 허용), 점등부터 4단계까지 24시간 미만", "why": "어기면 Flash 저장이 'CFG ERR schedule flash write fail' 로 거부된다"}
 ],
 "calc": {"id": "effective_pwm", "text": "실제 출력 = round(기준 밝기 x 시작 밝기 / 100). 99 초과면 99, 0 초과 10 미만이면 10", "keys": ["manual_40w", "manual_5w1", "manual_5w2", "start_pwm"]},
 "year_table": {
  "inputs": [
   {"key": "region", "label": "지역", "type": "text", "max_bytes_utf8": 47, "help": "목록(시/군 36곳)에서 고르거나 직접 입력(한글 15자). 단말에 저장된다"},
   {"key": "lat", "label": "위도", "type": "decimal", "min": -90, "max": 90, "help": "단말에는 도 x 1,000,000 정수로 저장. '37.5665, 126.9780' 이나 지도 주소를 붙여도 된다"},
   {"key": "lon", "label": "경도", "type": "decimal", "min": -180, "max": 180, "help": ""},
   {"key": "on_corr", "label": "점등 보정", "type": "int", "unit": "분", "min": -180, "max": 180, "default": 0, "help": "일몰 기준. 표에 들어간다"},
   {"key": "off_corr", "label": "소등 보정", "type": "int", "unit": "분", "min": -180, "max": 180, "default": 0, "help": "일출 기준. 표에 들어간다"}
  ],
  "preview": "월별 1일/15일 24행 : 날짜, 점등, 소등, 점등 시간",
  "origin_display": "지역 · 위도 경도 · 보정 +a / +b분 · 만든 쪽(펌웨어 기본 표 / PC 도구 / 서버)",
  "calc": "suntable.build_table(lat_e6, lon_e6, on_corr, off_corr) — 단말·서버와 같은 정수 계산"
 }
}
