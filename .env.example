# solar_power_control 환경 변수 견본.
#   cp .env.example .env   후 비밀번호를 채운다. .env 는 커밋하지 않는다(.gitignore).
#
# 값 하나가 두 곳에서 읽힌다:
#   - docker compose      : ${POSTGRES_*}, COMPOSE_PROFILES
#   - backend (env_file)  : 나머지 전부. 단, compose 가 컨테이너 안에서 MQTT_HOST 등
#                           일부를 서비스명으로 덮어쓴다(docker-compose.yml 참고).

# ── 앱 ───────────────────────────────────────────────────────────────
APP_ENV=dev                 # dev | prod
LOG_LEVEL=INFO

# ── compose 프로파일 ─────────────────────────────────────────────────
# local-db = 이 EC2/PC 안에 postgres 컨테이너를 띄운다. RDS 로 옮기면 비운다.
COMPOSE_PROFILES=local-db

# ── 4차 TLS + 브로커 분리 (ADR-006, docs/04 "4차 전환 런북") ──────────
# 인증서 발급(infra/scripts/cert-issue.sh) 뒤 아래 줄의 주석을 푼다(Linux 구분자 ':').
#   운영 브로커 = 8883(TLS)만 호스트에 공개, 호스트 1883 = 시험 브로커(solarlte-test 만), 관리 화면 443.
# 되돌리기 = 이 줄을 다시 주석 처리하고 docker compose up -d --remove-orphans.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# 시험 브로커(mosquitto-test) 의 solarlte-test 비밀번호. 비우면 사양서 공개값 solarlte-test-2026.
#MQTT_TEST_BROKER_PASSWORD=

# ── DB ───────────────────────────────────────────────────────────────
# 컨테이너 안에서는 호스트명이 postgres(서비스명). 호스트에서 backend 를 직접 돌리면 localhost.
# RDS 전환 시: postgresql+asyncpg://<user>:<pw>@<rds-endpoint>:5432/iotlight?ssl=require
DATABASE_URL=postgresql+asyncpg://iotlight:change-me-db@postgres:5432/iotlight
# local-db 프로파일 전용 (위 URL 과 같은 값이어야 한다)
POSTGRES_USER=iotlight
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=iotlight

# ── 관리 화면 로그인 (ADR-011) ──────────────────────────────────────
# 로그인 화면의 계정. backend 가 판정하고 nginx 가 /api 앞에서 묻는다(auth_request). 스크립트는 Basic 헤더도 된다.
# 첫 배포 전 반드시 바꿀 것 — change-me-admin 이면 web 컨테이너가 기동을 거부한다. 바꾸면 기존 로그인은 모두 끊긴다.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
# 선택 — 두 번째 계정(보통 최고관리자가 아닌 관리자). 둘 다 채웠을 때만 만들어진다.
OPERATOR_USER=
OPERATOR_PASSWORD=
# 최고관리자 = 전체 명령·트리 편집 (쉼표로 여러 명). nginx 가 로그인한 사용자명을
# X-Remote-User 로 backend 에 넘기고, backend 가 이 목록으로 판정한다(ADR-005).
SUPER_ADMIN_USERS=admin
# 선택 — 로그인 유지 시간(시간, 기본 168 = 7일), 세션 서명 키(비우면 위 비밀번호에서 유도).
#SESSION_HOURS=168
#SESSION_SECRET=

# ── 5차: 법정동 트리·원격 명령 (ADR-005) ─────────────────────────────
# 카카오 로컬 REST 키 — 법정동(주소) 검색. 비우면 개발 환경(APP_ENV=dev)에서만 코드 직접 입력.
KAKAO_REST_API_KEY=
# 카카오 JavaScript 키 — 지도 표시(대시보드·승인 화면 위치 보정). REST 키와 다른 값.
# 브라우저로 내려가는 공개 키라 비밀은 아니지만, 카카오 콘솔 [플랫폼 > Web > 사이트 도메인]에
# 관제 화면 주소(http://infontech.co.kr 등)를 등록해야 동작한다. 비우면 지도 자리에 안내만 나온다.
KAKAO_JS_KEY=
# 온실가스 감축량 계수(kgCO2eq/kWh) — 국가 전력 배출계수. 확정값을 받으면 바꾼다.
GHG_KG_PER_KWH=0.4781
# ── S-24 알람 (ADR-009) — 기준 시간은 운영하며 조정. 비우면 기본값 ─────────────
# ALARM_EVAL_SEC=30
# ALARM_CONFIG_HOLD_SEC=1800
# ALARM_LOCAL_HOLD_SEC=3600
# ALARM_REBOOT_PER_DAY=3
# ALARM_RETENTION_DAYS=365
# ── S-25 스케줄 배포 (ADR-010) ──────────────────────────────────────
# DEPLOY_RATE_PER_SEC=10
# DEPLOY_MAX_ROUNDS=3
# 승인(ACTIVE)에 법정동 말단 배정을 요구. 운영 true. 개발 compose 는 false 로 덮어쓴다.
APPROVE_REQUIRES_NODE=true
# COMMAND exp(초) — 단말이 이 시간 안에 받지 못하면 EXPIRED
COMMAND_EXP_SEC=30
# 명령 전체 종료 시한(초). 이때까지 응답 없는 대상은 TIMEOUT
COMMAND_TIMEOUT_SEC=180
# 대상 단말당 최대 발송 횟수(첫 발송 포함)
COMMAND_MAX_ATTEMPTS=3
# 같은 단말 재발송 최소 간격(초) — 단말이 뭔가 보낸 직후 재시도할 때 적용
COMMAND_RETRY_MIN_SEC=20

# ── MQTT (서버 계정) ────────────────────────────────────────────────
# 사양서 §1.1.2.2: 서버 계정은 `server` 1개, iotlight/# readwrite.
# 컨테이너 안에서는 compose 가 MQTT_HOST=mosquitto, MQTT_PORT=1883, MQTT_TLS=false 로 덮어쓴다.
# 4차 이후에도 backend ↔ broker 는 컨테이너 네트워크 안 평문 1883 을 쓴다(호스트 밖으로 안 나감).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=server
MQTT_PASSWORD=change-me-mqtt
MQTT_TLS=false
MQTT_TOPIC_ROOT=iotlight

# ── 단말 인증 키 (HMAC, 사양서 §1.1.2.2 / ADR-003) ─────────────────
# 단말 비밀번호 = HMAC-SHA256(K, UUID) 앞 16바이트 hex. 브로커(go-auth)가 접속마다
# backend /internal/mqtt/auth 에 물어보고, backend 가 이 키들로 계산해 비교한다.
# 형식: "<키ID>:<hex 64자>", 쉼표로 여러 개(키 교체 중엔 K1,K2 둘 다 허용).
# 아래는 사양서의 **공개 시험 키**다(전환 순서 1~2단계용). 운영은 K1:<hex64> 로 바꾼다 —
# 별도 전달받은 MQTT_인증키_K1.md 의 값. 절대 커밋·로그·DB 에 남기지 않는다.
MQTT_HMAC_KEYS=TEST:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# /internal/mqtt/* 호출에 X-Auth-Secret 헤더를 요구할 때만 채운다. go-auth 의 http 백엔드는
# 사용자 정의 헤더를 못 보내므로 기본은 비워 둔다(= 검사 안 함). 보호는 "backend 포트를
# 호스트에 열지 않는다"가 담당한다.
MQTT_AUTH_SHARED_SECRET=

# 1차 공용 시험 계정(solarlte-test / solarlte-test-2026)을 passwd 에 포함할지.
# 2차 시작(단말별 계정 전환)과 함께 false 로 바꾼다 — 사양서 §1.1.2.2 "공용 계정은 2차 시작과 함께 폐기".
MQTT_TEST_ACCOUNT_ENABLED=true

# ── 단말별 계정 내보내기 (2차) ──────────────────────────────────────
# backend 가 DB 에서 passwd/aclfile 을 생성해 이 경로에 쓰고, mosquitto entrypoint 감시
# 루프가 설치+HUP 한다. 비우면 기능 꺼짐. 컨테이너 안 경로 = mqtt-dynamic 볼륨.
MOSQUITTO_PASSWD_EXPORT=/var/lib/iotlight/mqtt/passwd.generated
MOSQUITTO_ACL_EXPORT=/var/lib/iotlight/mqtt/aclfile.generated

# ── 수집·판정 파라미터 ──────────────────────────────────────────────
# Telemetry 이력을 DB 에 몰아 넣는 배치 주기(초). 실패한 묶음은 버리고 카운트한다.
TELEMETRY_FLUSH_INTERVAL_SEC=1.0
# telemetry 월 파티션 보존 개월 수. 13 = 1년 + 여유 1달. 지난 파티션은 DROP.
TELEMETRY_RETENTION_MONTHS=13
# ── Online/Offline (ADR-004, 사양서 §16.1) ──────────────────────────
# 브로커 접속/해제 로그 파일. mosquitto 가 mqtt-dynamic 볼륨에 쓰고 backend 가 tail 한다.
# 비우면 로그 기반 판정 꺼짐(수신 시각 규칙만). 컨테이너 안 경로.
MOSQUITTO_LOG_PATH=/var/lib/iotlight/mqtt/mosquitto.log
# 수신 시각 보조 규칙: 단말 ti × 이 값 동안 무수신이면 OFFLINE
DEVICE_ONLINE_FACTOR=3
# PENDING 단말(Telemetry 없음)은 REGISTER 재전송 최대 30분 × 2 + 여유 = 70분 무수신이면 OFFLINE
PENDING_OFFLINE_SEC=4200
# cv_server != cv_device 일 때 CONFIG_SET 재전송 최소 간격(초). 같은 단말에 매 Telemetry 마다
# 쏘지 않기 위한 쿨다운. 타이머가 아니라 "다음 Telemetry 수신 시점"에 판단한다.
CONFIG_RESEND_COOLDOWN_SEC=60
# 브로커 재시작 뒤 1만 대가 한꺼번에 REGISTER 할 때 서버 응답(REGISTER_ACK+CONFIG_SET) 초당 상한.
REGISTER_REPLY_RATE_PER_SEC=200
